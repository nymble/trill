{
  "$description": "Trillium brand tokens (Stage palette). Ambient Lab. Format: W3C Design Tokens (DTCG).",
  "color": {
    "black": {
      "$type": "color",
      "$value": "#0C0C0D",
      "$description": "Primary ground. ~58% of any layout."
    },
    "graphite": {
      "$type": "color",
      "$value": "#232326",
      "$description": "Panels, cards, icon ground. ~20%."
    },
    "ash": {
      "$type": "color",
      "$value": "#8A8580",
      "$description": "Secondary text on black (5.4:1)."
    },
    "ash-light": {
      "$type": "color",
      "$value": "#B3ADA4",
      "$description": "Resting UI icons and captions on black (8.8:1)."
    },
    "warm-white": {
      "$type": "color",
      "$value": "#F4F1EA",
      "$description": "Text on black (17.3:1); light ground. ~13%."
    },
    "signal": {
      "$type": "color",
      "$value": "#FF5A1F",
      "$description": "The brand orange: mark, active state, primary button. ~6%."
    },
    "amber": {
      "$type": "color",
      "$value": "#FFB020",
      "$description": "Levels, meters, highlights only. ~3%."
    },
    "ember": {
      "$type": "color",
      "$value": "#E8480F",
      "$description": "Mark color on light grounds (not for text)."
    },
    "rust": {
      "$type": "color",
      "$value": "#C23D0E",
      "$description": "Orange text on light grounds (4.7:1 on warm white)."
    },
    "unavailable": {
      "$type": "color",
      "$value": "#55524D",
      "$description": "Disabled UI on black (decorative, not for text)."
    },
    "connected": {
      "$type": "color",
      "$value": "#6FAE9A",
      "$description": "Connected / OK status dot."
    },
    "record": {
      "$type": "color",
      "$value": "#FF5A1F",
      "$description": "Alias of signal for live/record states."
    }
  },
  "semantic": {
    "bg": {
      "$type": "color",
      "$value": "{color.black}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.graphite}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.warm-white}"
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.ash}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.signal}"
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.black}",
      "$description": "Text on signal orange. Never white (2.8:1)."
    },
    "icon-rest": {
      "$type": "color",
      "$value": "{color.ash-light}"
    },
    "icon-hover": {
      "$type": "color",
      "$value": "{color.warm-white}"
    },
    "icon-active": {
      "$type": "color",
      "$value": "{color.signal}"
    },
    "light-bg": {
      "$type": "color",
      "$value": "{color.warm-white}"
    },
    "light-text": {
      "$type": "color",
      "$value": "{color.black}"
    },
    "light-accent-text": {
      "$type": "color",
      "$value": "{color.rust}"
    },
    "light-mark": {
      "$type": "color",
      "$value": "{color.ember}"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Outfit",
        "Inter",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Headings and wordmark. Weights 300-500."
    },
    "ui": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui",
        "-apple-system",
        "sans-serif"
      ],
      "$description": "Interface and body. 400-600."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "SF Mono",
        "monospace"
      ],
      "$description": "Firmware versions, MIDI values, sensor readouts."
    }
  },
  "radius": {
    "app-icon": {
      "$type": "dimension",
      "$value": "22.4%"
    },
    "card": {
      "$type": "dimension",
      "$value": "20px"
    },
    "control": {
      "$type": "dimension",
      "$value": "10px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "icon": {
    "grid": {
      "$type": "dimension",
      "$value": "24px"
    },
    "stroke": {
      "$type": "dimension",
      "$value": "1.75px"
    }
  }
}